{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            // --reload-dir keeps the file watcher off .git/, .venv/ and __pycache__,
            // which otherwise roughly doubles startup time.
            "args": [
                "main:app",
                "--reload",
                "--reload-dir",
                "app",
                "--reload-dir",
                "templates"
            ],
            "jinja": true,
            "justMyCode": true
        }
    ]
}
